{
  "info": {
    "name": "Attributes Module",
    "description": "Requests to validate attributes module use cases from specs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Attribute",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}{{apiPrefix}}/{{apiVersion}}/attributes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cor\",\n  \"code\": \"COLOR\",\n  \"description\": \"Cor principal do produto\",\n  \"type\": \"TEXT\",\n  \"isMultiValue\": false,\n  \"isRequired\": true\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('response success true', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "apiPrefix",
      "value": "/api"
    },
    {
      "key": "apiVersion",
      "value": "v1"
    }
  ]
}
