{
  "info": {
    "name": "Auth (Identity) Module",
    "description": "Spec-driven requests for the identity module endpoints (not wired in app yet).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Identity User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}{{apiPrefix}}/{{apiVersion}}/identity/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"admin+{{$timestamp}}@example.com\",\n  \"name\": \"Admin User\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 201', function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "apiPrefix",
      "value": "/api"
    },
    {
      "key": "apiVersion",
      "value": "v1"
    }
  ]
}
