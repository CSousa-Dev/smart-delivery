{
  "info": {
    "name": "Inventory Module",
    "description": "Requests to validate inventory module use cases from specs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Unit of Measure",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}{{apiPrefix}}/{{apiVersion}}/inventory/units-of-measure",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"organizationId\": \"{{organizationId}}\",\n  \"code\": \"KG\",\n  \"name\": \"Quilograma\",\n  \"symbol\": \"kg\",\n  \"allowsFraction\": true,\n  \"createdBy\": \"{{actorUserId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('response success true', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "apiPrefix",
      "value": "/api"
    },
    {
      "key": "apiVersion",
      "value": "v1"
    },
    {
      "key": "organizationId",
      "value": ""
    },
    {
      "key": "actorUserId",
      "value": ""
    }
  ]
}
