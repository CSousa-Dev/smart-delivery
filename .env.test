# Server Configuration
NODE_ENV=development
PORT=3000

# CORS Configuration
CORS_ORIGIN=*

# API Configuration
API_PREFIX=/api
API_VERSION=v1

# Logging
LOG_LEVEL=info

# Features Flags
ENABLE_SWAGGER=false
ENABLE_METRICS=false

# Redis (for future use)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Database (for future use)
DATABASE_URL_ATTRIBUTES=mysql://root:root@localhost:3306/attributes_test_db
DATABASE_URL_ORGANIZATION=mysql://root:root@localhost:3307/organization_db
DATABASE_URL_PRODUCTS=mysql://root:root@localhost:3308/products_db

DATABASE_URL_ATTRIBUTES_TEST=mysql://root:root@localhost:3306/attributes_test_db
DATABASE_URL_ORGANIZATION_TEST=mysql://root:root@localhost:3307/organization_db
DATABASE_URL_PRODUCTS_TEST=mysql://root:root@localhost:3308/products_db