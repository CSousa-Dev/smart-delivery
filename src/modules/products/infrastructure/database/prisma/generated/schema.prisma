generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_PRODUCTS")
}

model Product {
  id               String                  @id @default(uuid()) @db.VarChar(36)
  organizationId   String                  @map("organization_id") @db.VarChar(36)
  businessUnitId   String                  @map("business_unit_id") @db.VarChar(36)
  categoryId       String                  @map("category_id") @db.VarChar(36)
  code             String                  @db.VarChar(40)
  codeNormalized   String                  @map("code_normalized") @db.VarChar(40)
  title            String                  @db.VarChar(120)
  titleNormalized  String                  @map("title_normalized") @db.VarChar(120)
  shortDescription String                  @map("short_description") @db.VarChar(160)
  description      String                  @db.VarChar(2000)
  createdBy        String                  @map("created_by") @db.VarChar(36)
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime?               @map("updated_at")
  images           ProductImage[]
  attributes       ProductAttributeValue[]

  @@unique([organizationId, codeNormalized], map: "products_org_code_normalized_key")
  @@unique([businessUnitId, titleNormalized], map: "products_bu_title_normalized_key")
  @@map("products")
}

model ProductImage {
  productId    String  @map("product_id") @db.VarChar(36)
  url          String  @db.VarChar(2048)
  displayOrder Int     @map("display_order")
  altText      String? @map("alt_text") @db.VarChar(255)
  isPrimary    Boolean @map("is_primary")
  product      Product @relation(fields: [productId], references: [id])

  @@id([productId, displayOrder])
  @@index([productId], map: "product_images_product_id_idx")
  @@map("product_images")
}

model ProductAttributeValue {
  productId   String  @map("product_id") @db.VarChar(36)
  attributeId String  @map("attribute_id") @db.VarChar(36)
  value       String  @db.VarChar(255)
  product     Product @relation(fields: [productId], references: [id])

  @@id([productId, attributeId, value])
  @@index([productId], map: "product_attribute_values_product_id_idx")
  @@index([attributeId], map: "product_attribute_values_attribute_id_idx")
  @@map("product_attribute_values")
}
